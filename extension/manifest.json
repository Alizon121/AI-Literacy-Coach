{
  "manifest_version": 3,
  "name": "AI Literacy Coach",
  "short_name": "AI Coach",
  "version": "1.0.0",
  "description": "Real-time AI prompt coaching for ChatGPT, Claude, Gemini, and more. Evaluates clarity and specificity, then suggests improvements.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Literacy Coach"
  },

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["storage"],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://api.groq.com/*"
  ],

  "icons": {
    "16": "icons/ai-literacy-coach-16.png",
    "32": "icons/ai-literacy-coach-32.png",
    "48": "icons/ai-literacy-coach-48.png",
    "128": "icons/ai-literacy-coach-128.png"
  },

  "options_page": "options.html",

  "web_accessible_resources": [
    {
      "resources": ["public/icons/*"],
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8000 https://api.groq.com"
  }
}
